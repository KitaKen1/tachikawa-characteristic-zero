    apply LinearMap.ext
    intro x
    obtain ⟨f, rfl⟩ := stableClass_surjective x
    change stableClass (k := k) ((c • g).comp f) = c • stableClass (k := k) (g.comp f)
    rw [LinearMap.smul_comp, map_smul]


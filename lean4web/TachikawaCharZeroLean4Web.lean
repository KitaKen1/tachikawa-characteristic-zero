    rightEnvelopingMap φ (u ⊗ₜ[k] (1:Rᵐᵒᵖ)) • (show N from f m) at h
  change (show N from f ((u ⊗ₜ[k] (1:Rᵐᵒᵖ)) • (show M from m))) =

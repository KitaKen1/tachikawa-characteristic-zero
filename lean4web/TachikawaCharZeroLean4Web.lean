  rw [show -((3*m:ℕ):ℤ)-1 = Int.negSucc (3*m) by omega]
  simp only [TwistedBranchWeights.weight,Nat.mul_div_cancel_left m (by omega : 0 < 3)]
  rw [pow_add,mul_comm]


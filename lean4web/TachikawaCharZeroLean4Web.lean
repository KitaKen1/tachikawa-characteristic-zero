  rw [Matrix.isUnit_iff_isUnit_det,isUnit_iff_ne_zero]
  exact positive_det_ne_zero a m hm

theorem negative_isUnit (a : ℤ) (m : ℕ) : IsUnit (negative a m) := by
  rw [Matrix.isUnit_iff_isUnit_det,isUnit_iff_ne_zero]
  exact negative_det_ne_zero a m


    (hK : ∀ i, FiniteDimensional k (K.X i)) (hL : ∀ i, FiniteDimensional k (L.X i)) (i : ℤ) :
    FiniteDimensional k ((mappingCone f).X i) := by
  let := hK (i+1)
  let := hL i
  let e := homotopyCofiber.XIsoBiprod f i (i+1) (by rfl) ≪≫ ModuleCat.biprodIsoProd _ _

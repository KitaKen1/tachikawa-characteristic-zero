  refine ⟨ModuleCat.ofHom (e.symm.toLinearMap.comp c), b, ?_⟩
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  exact congrArg Subtype.val (e.apply_symm_apply (c x))


    (hK : ∀ i, Projective (K.X i)) (hL : ∀ i, Projective (L.X i)) (i : ℤ) :
    Projective ((mappingCone f).X i) := by
  let := hK (i+1)
  let := hL i
  exact Projective.of_iso (homotopyCofiber.XIsoBiprod f i (i+1) (by rfl)).symm inferInstance


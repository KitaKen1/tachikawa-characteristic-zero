    (StableHom (k := k) (R := R) (M := M) (N := N) →ₗ[k]
      StableHom (k := k) (R := R) (M := M) (N := L)) :=
  (projectiveFactors (k := k)).liftQ stablePostcomposeLinear (by
    intro g hg
    apply LinearMap.ext
    intro x
    obtain ⟨f, rfl⟩ := stableClass_surjective x

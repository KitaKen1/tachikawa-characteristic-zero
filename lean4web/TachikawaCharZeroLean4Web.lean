variable {N : ModuleCat.{0} R} (ε : Q.X 0 ⟶ N) (hε : Q.d 1 0 ≫ ε=0)

theorem eval_sub {a : ℤ} (f g : Cochain P Q a) (hf : Closed (k:=k) f)

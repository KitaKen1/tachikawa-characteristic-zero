    (cokerMap P Q hp hq pproj qfin qproj u₀ j) :=
  (hasSquare P Q hp hq pproj qfin qproj u₀ j).some

def chainMap : P ⟶ Q :=
  ChainComplex.ofHom
    (fun j => ModuleCat.ofHom (square P Q hp hq pproj qfin qproj u₀ j).map) (fun j => by
      apply ModuleCat.hom_ext
      apply LinearMap.ext

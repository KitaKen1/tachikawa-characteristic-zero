lemma leftIndExtendLinear_right (φ : R →ₐ[k] S) {M : ModuleCat (Alg k R U)} {N : ModuleCat (Alg k S U)}
    (f : M ⟶ (AlgebraInduction.res (leftEnvelopingMap (U := U) φ)).obj N) (u : Uᵐᵒᵖ) (x) :

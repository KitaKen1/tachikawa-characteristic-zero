    [AddCommGroup U₂] [Module ℚ U₂] [AddCommGroup V₁] [Module ℚ V₁]
    [AddCommGroup V₂] [Module ℚ V₂] [AddCommGroup W₁] [Module ℚ W₁]
    [AddCommGroup W₂] [Module ℚ W₂]

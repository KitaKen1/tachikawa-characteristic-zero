def positive (a : ℤ) (m : ℕ) : Matrix (Fin 2) (Fin 2) ℚ :=
  !![(H₁^m)⁻¹, -SignedDownHom.sign (k:=ℚ) a;
     (H₂^m)⁻¹, -SignedDownHom.sign (k:=ℚ) a]
def negative (a : ℤ) (m : ℕ) : Matrix (Fin 2) (Fin 2) ℚ :=
  !![H₁^(m+2), -SignedDownHom.sign (k:=ℚ) a;
     H₂^(m+2), -SignedDownHom.sign (k:=ℚ) a]

